# Notion Integration
NOTION_API_KEY=

# Prompt pages
OUTREACH_CONTROLLER_PROMPT_URL=https://app.notion.com/p/a2ca22b20dde47a8b63e5b24e8131e5e
MAILBOX_REPLY_SCAN_PROMPT_URL=https://app.notion.com/p/907ad7080d6c4c7587f0fcc7281bc6d7

# Databases (browser copy-link URLs are fine)
SESSION_DATA_SOURCE_URL=https://app.notion.com/p/9cc4dde63f3545f4a36c44e7a70a297d
MAILBOX_STATE_DATA_SOURCE_URL=https://app.notion.com/p/81074a2cbeac41a8a724c94811a57e11

# Cookies-only auth (small JSON — upload to S3 / server; do NOT commit)
# Multi-account: one file per account under NOTION_AUTH_DIR
NOTION_AUTH_DIR=./auth
NOTION_ACCOUNT=default
# Or explicit path instead of ACCOUNT:
# NOTION_AUTH_STATE_PATH=./auth/mark.json

# Optional: old Chromium profile — only for: npm run worker:export-auth
# NOTION_PROFILE_DIR=./profiles/outreach-worker

# Runtime
# Local interactive login: false | Docker / server: true
PLAYWRIGHT_HEADLESS=false
# AI_PANEL_TIMEOUT_MS=90000
PLAYWRIGHT_TRACE=false
ARTIFACT_DIR=artifacts
# Use a distinct WORKER_ID per account process when running in parallel
WORKER_ID=worker-local-1
# LOCK_TTL_MS=900000
# POLL_INTERVAL_MS=300000
