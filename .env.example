# Notion Integration
NOTION_API_KEY=

# Prompt pages
OUTREACH_CONTROLLER_PROMPT_URL=https://app.notion.com/p/a2ca22b20dde47a8b63e5b24e8131e5e
MAILBOX_REPLY_SCAN_PROMPT_URL=https://app.notion.com/p/907ad7080d6c4c7587f0fcc7281bc6d7

# Databases (browser copy-link URLs are fine)
SESSION_DATA_SOURCE_URL=https://app.notion.com/p/9cc4dde63f3545f4a36c44e7a70a297d
MAILBOX_STATE_DATA_SOURCE_URL=https://app.notion.com/p/81074a2cbeac41a8a724c94811a57e11

# Persistent Chromium profile (login once via npm run worker:login)
# Docker Compose overrides this to /app/profiles/outreach-worker and mounts ./profiles
NOTION_PROFILE_DIR=./profiles/outreach-worker

# Runtime
# Local interactive: false | Docker Compose forces true
PLAYWRIGHT_HEADLESS=false
# Wait for Notion AI corner (default 60000). Raise on slow servers.
# AI_PANEL_TIMEOUT_MS=90000
# Full traces are ~100–200MB each; leave false unless debugging a failure
PLAYWRIGHT_TRACE=false
ARTIFACT_DIR=artifacts
WORKER_ID=worker-local-1
# LOCK_TTL_MS=900000
# POLL_INTERVAL_MS=300000
# Playwright temp is forced to ./.playwright-tmp (not system /tmp) for EIO stability
