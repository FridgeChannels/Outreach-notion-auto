# Notion Integration
NOTION_API_KEY=

# Prompt pages
OUTREACH_CONTROLLER_PROMPT_URL=https://app.notion.com/p/a2ca22b20dde47a8b63e5b24e8131e5e
MAILBOX_REPLY_SCAN_PROMPT_URL=https://app.notion.com/p/907ad7080d6c4c7587f0fcc7281bc6d7

# Databases (browser copy-link URLs are fine)
SESSION_DATA_SOURCE_URL=https://app.notion.com/p/9cc4dde63f3545f4a36c44e7a70a297d
MAILBOX_STATE_DATA_SOURCE_URL=https://app.notion.com/p/81074a2cbeac41a8a724c94811a57e11

# Cookies-only auth (small JSON — upload to S3 / server; do NOT commit)
# Multi-account: one file per account under NOTION_AUTH_DIR
NOTION_AUTH_DIR=./auth
NOTION_ACCOUNT=default
# Or explicit path instead of ACCOUNT:
# NOTION_AUTH_STATE_PATH=./auth/mark.json

# Optional: old Chromium profile — only for: npm run worker:export-auth
# NOTION_PROFILE_DIR=./profiles/outreach-worker

# Runtime
# Local interactive login: false | Docker / server: true
PLAYWRIGHT_HEADLESS=false
# AI_PANEL_TIMEOUT_MS=90000
PLAYWRIGHT_TRACE=false
ARTIFACT_DIR=artifacts

# --- Multi-account (same machine) ---
# Comma-separated; N names => N processes via: npm run workers:start
# Each needs auth/<name>.json (npm run worker:login per account).
# WORKER_ACCOUNTS=mark,hayes
# WORKER_STAGGER_SEC=8
# Per-process NOTION_ACCOUNT / WORKER_ID / TMPDIR / ARTIFACT_DIR are set by the script.
#
# Single-process fallback (npm run worker):
WORKER_ID=worker-local-1
# Due Sessions per poll cycle per worker (keep modest when many workers)
OUTREACH_BATCH_LIMIT=10
# POLL_INTERVAL_MS=120000
# LOCK_TTL_MS=900000
# STALE_CLAIM_MS=1800000
# SESSION_WRITEBACK_TIMEOUT_MS=480000
# Wait for Status=Running visible before AI submit (multi-worker consistency)
# RUNNING_VISIBILITY_TIMEOUT_MS=30000
# RUNNING_VISIBILITY_GRACE_MS=1000
# TECHNICAL_RETRY_BACKOFF_BASE_MS=30000
# Reuse one AI chat across Sessions in a poll batch; New chat after random N rounds
# CHAT_REUSE_MIN_ROUNDS=15
# CHAT_REUSE_MAX_ROUNDS=25
